{

  "version": 2,
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.12",
        "startCommand": "gunicorn -w 4 -k uvicorn.workers.UvicornWorker app.main:app"
      }
    }
  ],
  "rewrites": [
    {
      "source": "^/(css|data|fonts|html|icon|images|js|video)/(.*)",
      "destination": "/$1/$2"
    },
    {
      "source": "/(.*)",
      "destination": "/app/main.py"
    }
  ]
}
